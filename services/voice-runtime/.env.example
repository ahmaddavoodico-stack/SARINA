# Supabase Auth is used only to validate the signed-in SARINA user.
# No external AI inference API is called.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
CORS_ORIGINS=https://your-sarina-domain.example
MAX_AUDIO_BYTES=20971520
MAX_AUDIO_SECONDS=90
MAX_TEXT_CHARS=6000

# Piper voice model paths (compose defaults shown here)
PIPER_FA_MODEL_PATH=/models/piper/fa_IR-amir-medium.onnx
PIPER_AR_MODEL_PATH=/models/piper/ar_JO-kareem-medium.onnx
# Whisper uses multilingual small by default; API accepts auto/fa/ar language hints.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=2
