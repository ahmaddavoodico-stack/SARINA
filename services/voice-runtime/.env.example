# Supabase Auth is used only to validate the signed-in SARINA user.
# No external AI inference API is called.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
CORS_ORIGINS=https://your-sarina-domain.example
MAX_AUDIO_BYTES=20971520
MAX_AUDIO_SECONDS=90
MAX_TEXT_CHARS=6000

# Arabic Piper voice model path (Persian TTS uses local tiny-ava Parisa female voice)
PIPER_AR_MODEL_PATH=/models/piper/ar_JO-kareem-medium.onnx
SARINA_TINY_AVA_CACHE=/tmp/sarina-models/tiny-ava
# Whisper uses multilingual small by default; API accepts auto/fa/ar language hints.
WHISPER_MODEL_PATH=/models/whisper/small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=2

# Whisper and Arabic Piper weights are provisioned into ./models for the Docker host. On Vercel, Whisper, Parisa and G2P assets are cached under writable /tmp on first use; inference is local after loading.

# Optional server-side allowlist for spoken AI replies (comma-separated Supabase Auth user IDs).
# Leave empty to disable TTS for everyone.
SARINA_TTS_ALLOWED_USER_IDS=
